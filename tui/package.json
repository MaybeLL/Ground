{
  "name": "@maybell/grounds-tui",
  "version": "0.2.49",
  "description": "Candidate review terminal workspace for Grounds",
  "type": "module",
  "bin": {
    "grounds-tui": "dist/bin.js"
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && node scripts/finalize-build.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/bin.tsx",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts test/*.test.tsx",
    "test:integration": "node --import tsx --test test/integration/*.test.ts",
    "test:package": "npm run build && node scripts/package-test.mjs",
    "test:scale": "GROUNDS_TUI_SCALE=1 npm run test:integration",
    "test:scale:cli": "GROUNDS_TUI_REPORT_SETUP=cli npm run test:scale",
    "test:release": "node scripts/require-mysql.mjs && npm run build && npm test && npm run test:scale",
    "prepublishOnly": "node -e \"throw new Error('Use the GitHub Releases workflow; npm registry publication is disabled')\"",
    "release:check": "node ../scripts/github-release-check.mjs"
  },
  "dependencies": {
    "chalk": "^6.0.1",
    "ink": "7.1.1",
    "marked": "^15.0.12",
    "react": "~19.2.0",
    "string-width": "^8.0.0",
    "strip-ansi": "^7.1.0",
    "wrap-ansi": "^10.0.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.8.3"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaybeLL/grounds-open.git",
    "directory": "tui"
  },
  "homepage": "https://github.com/MaybeLL/grounds-open",
  "bugs": {
    "url": "https://github.com/MaybeLL/grounds-open/issues"
  },
  "license": "MIT"
}
