stateDiagram-v2
  state "准备中" as Prep
  state "准备受阻" as Blocked
  state "就绪" as Ready
  state "使用中" as InUse
  state "已暂停（保留待细化）" as Paused
  state "释放中" as Rel
  state "已释放" as Done
  [*] --> Prep: 归属者用例申请
  Prep --> Ready: 文件、运行资源、挂载均核实
  Prep --> Blocked: 失败，保留 Workspace
  Blocked --> Prep: 接手者继续准备
  Ready --> InUse: Operation 取得占用租约
  InUse --> Ready: 确认停止，归还租约
  Ready --> Paused: 归属者终结且保留，暂停执行容器
  Paused --> Ready: 移交给 refinement，恢复并核对
  Ready --> Rel: 归属者用例释放
  Paused --> Rel: 结束工作或保留到期
  Blocked --> Rel: 放弃
  Rel --> Done: 卸载并回收自建资源，Workspace 按保留意图处理
  Done --> [*]
