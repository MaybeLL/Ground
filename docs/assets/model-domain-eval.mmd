  classDef res fill:#fff4e0,stroke:#c08a2d,color:#5a3b06;
  classDef eva fill:#fdecef,stroke:#b5546a,color:#5a1424;
  classDef q fill:#f2f2f2,stroke:#888,color:#333;
  class SU,EXP,SS,CASE,AR,GV def;
  class XR,RN,T,EOP fact;
  class CS eva;
  class ESB res;
  class GRD eva;
  class Q1,Q2 q;
