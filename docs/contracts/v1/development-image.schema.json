{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patchledger.dev/contracts/v1/development-image.schema.json",
  "title": "Grounds internal development recipes and explicit local BuildKit preparations",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_type",
        "command",
        "recipe"
      ],
      "properties": {
        "result_type": {
          "const": "grounds.result.development-image/v1"
        },
        "command": {
          "enum": [
            "code-workspace.recipe-save",
            "code-workspace.recipe-show"
          ]
        },
        "recipe": {
          "$ref": "#/$defs/recipe"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_type",
        "command",
        "preparation"
      ],
      "properties": {
        "result_type": {
          "const": "grounds.result.development-image/v1"
        },
        "command": {
          "enum": [
            "code-workspace.recipe-prepare",
            "code-workspace.recipe-preparation-show",
            "code-workspace.recipe-preparation-cancel",
            "code-workspace.recipe-preparation-cleanup"
          ]
        },
        "preparation": {
          "$ref": "#/$defs/preparation"
        }
      }
    }
  ],
  "$defs": {
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "recipe_id",
        "revision_id",
        "repository_id",
        "version",
        "name",
        "dockerfile",
        "files",
        "digest",
        "request_digest",
        "attribution",
        "created_at"
      ],
      "properties": {
        "format": {
          "const": "grounds.development-recipe/v1"
        },
        "recipe_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "revision_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "repository_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "maxLength": 128
        },
        "dockerfile": {
          "type": "string",
          "maxLength": 240
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "mode",
              "digest",
              "content"
            ],
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 240
              },
              "mode": {
                "enum": [
                  "100644",
                  "100755"
                ]
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "content": {
                "type": "string",
                "maxLength": 5592408
              }
            }
          }
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "request_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "attribution": {
          "$ref": "common.schema.json#/$defs/attribution"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "preparation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "preparation_id",
        "recipe_revision_id",
        "repository_id",
        "database_id",
        "host_id",
        "data_root",
        "engine_id",
        "platform",
        "endpoint",
        "builder",
        "input_digest",
        "request_digest",
        "target",
        "build_args",
        "registration_operation_id",
        "state",
        "attribution",
        "created_at"
      ],
      "properties": {
        "format": {
          "const": "grounds.development-image-preparation/v1"
        },
        "preparation_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "recipe_revision_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "repository_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "database_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "host_id": {
          "type": "string",
          "format": "uuid"
        },
        "data_root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "engine_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "platform": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "endpoint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "builder": {
          "const": "docker-buildkit/v1"
        },
        "input_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "request_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "environment_id",
            "expected_version",
            "configuration"
          ],
          "properties": {
            "environment_id": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "expected_version": {
              "type": "integer",
              "minimum": 0
            },
            "configuration": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "postgres": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "image"
                  ],
                  "properties": {
                    "image": {
                      "type": "string",
                      "pattern": "^sha256:[a-f0-9]{64}$"
                    }
                  }
                }
              }
            }
          }
        },
        "build_args": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "registration_operation_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "environment_revision_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "registration_error": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "image": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "state": {
          "enum": [
            "registered",
            "blocked",
            "building",
            "needs-recovery",
            "ready",
            "cancelled"
          ]
        },
        "attribution": {
          "$ref": "common.schema.json#/$defs/attribution"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "cancellation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation_id",
            "attribution",
            "requested_at"
          ],
          "properties": {
            "operation_id": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "attribution": {
              "$ref": "common.schema.json#/$defs/attribution"
            },
            "requested_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "cleanup": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation_id",
            "attribution",
            "state"
          ],
          "properties": {
            "operation_id": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "attribution": {
              "$ref": "common.schema.json#/$defs/attribution"
            },
            "state": {
              "enum": [
                "pending",
                "complete"
              ]
            }
          }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment_id",
        "expected_version",
        "configuration"
      ],
      "properties": {
        "environment_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "expected_version": {
          "type": "integer",
          "minimum": 0
        },
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "postgres": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "image"
              ],
              "properties": {
                "image": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                }
              }
            }
          }
        }
      }
    }
  }
}
