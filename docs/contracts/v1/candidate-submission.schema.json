{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patchledger.dev/contracts/v1/candidate-submission.schema.json",
  "title": "Grounds CandidateSubmission v1/v2 提交契约",
  "oneOf": [
    { "$ref": "#/$defs/v1" },
    { "$ref": "#/$defs/v2" }
  ],
  "$defs": {
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": { "$ref": "common.schema.json#/$defs/claim" }
    },
    "v1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "explanation", "claims"],
      "properties": {
        "format": { "const": "patchledger.candidate-submission/v1" },
        "explanation": { "$ref": "common.schema.json#/$defs/longText" },
        "claims": { "$ref": "#/$defs/claims" }
      }
    },
    "v2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "explanation", "claims", "change_index", "change_rationales"],
      "properties": {
        "format": { "const": "patchledger.candidate-submission/v2" },
        "explanation": { "$ref": "common.schema.json#/$defs/longText" },
        "claims": { "$ref": "#/$defs/claims" },
        "change_index": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "patch_digest", "units_digest"],
          "properties": {
            "format": { "const": "patchledger.change-index/v1" },
            "patch_digest": { "$ref": "common.schema.json#/$defs/sha256" },
            "units_digest": { "$ref": "common.schema.json#/$defs/sha256" }
          }
        },
        "change_rationales": { "type": "array", "maxItems": 10000, "items": { "$ref": "common.schema.json#/$defs/changeRationale" } }
      }
    }
  }
}
