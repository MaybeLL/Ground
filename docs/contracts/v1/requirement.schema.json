{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patchledger.dev/contracts/v1/requirement.schema.json",
  "title": "Grounds Requirement YAML v1 契约",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "summary", "outcomes"],
  "properties": {
    "format": { "const": 1 },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "context": {
      "type": "string",
      "maxLength": 65536
    },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "decisions": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "common.schema.json#/$defs/decision" }
    },
    "open_questions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "blocking"],
        "properties": {
          "question": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "blocking": { "type": "boolean" },
          "assumption": { "type": "string", "minLength": 1, "maxLength": 16384 }
        }
      }
    }
  }
}
