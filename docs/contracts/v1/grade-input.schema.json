{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patchledger.dev/contracts/v1/grade-input.schema.json",
  "title": "External evaluator grade file",
  "type": "object",
  "required": ["criteria"],
  "properties": {
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "if": {"required": ["reused_from"]},
        "then": {"properties": {"final": {"const": "satisfied"}}},
        "required": ["criterion_id", "independent", "reconciliation", "final", "rationale"],
        "properties": {
          "criterion_id": {"$ref": "work-results.schema.json#/$defs/Id"},
          "independent": {"$ref": "#/$defs/verdict"},
          "reconciliation": {"enum": ["corroborated", "contradicted", "not_determined"]},
          "final": {"$ref": "#/$defs/verdict"},
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]+$"
          },
          "reused_from": {"$ref": "work-results.schema.json#/$defs/Id"},
          "evidence": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  },
  "$defs": {"verdict": {"enum": ["satisfied", "unsatisfied", "indeterminate"]}}
}
