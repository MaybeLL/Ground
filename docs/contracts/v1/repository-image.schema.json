{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patchledger.dev/contracts/v1/repository-image.schema.json",
  "title": "Grounds fixed build materials and local image preparation",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_type",
        "command",
        "material"
      ],
      "properties": {
        "result_type": {
          "const": "grounds.result.repository-image/v1"
        },
        "command": {
          "enum": [
            "code-workspace.build-material-capture",
            "code-workspace.build-material-show"
          ]
        },
        "material": {
          "$ref": "#/$defs/material"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_type",
        "command",
        "preparation"
      ],
      "properties": {
        "result_type": {
          "const": "grounds.result.repository-image/v1"
        },
        "command": {
          "enum": [
            "code-workspace.image-prepare",
            "code-workspace.image-show",
            "code-workspace.image-cancel",
            "code-workspace.image-cleanup"
          ]
        },
        "preparation": {
          "$ref": "#/$defs/preparation"
        }
      }
    }
  ],
  "$defs": {
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "material_id",
        "repository_id",
        "commit",
        "dockerfile",
        "files",
        "digest",
        "request_digest",
        "attribution",
        "created_at"
      ],
      "properties": {
        "format": {
          "const": "grounds.repository-build-material/v1"
        },
        "material_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "repository_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "commit": {
          "type": "string",
          "pattern": "^(sha1:[a-f0-9]{40}|sha256:[a-f0-9]{64})$"
        },
        "dockerfile": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "mode",
              "blob",
              "digest",
              "content"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "mode": {
                "enum": [
                  "100644",
                  "100755"
                ]
              },
              "blob": {
                "type": "string",
                "pattern": "^(sha1:[a-f0-9]{40}|sha256:[a-f0-9]{64})$"
              },
              "digest": {
                "$ref": "common.schema.json#/$defs/sha256"
              },
              "content": {
                "type": "string",
                "contentEncoding": "base64"
              }
            }
          }
        },
        "digest": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "request_digest": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "attribution": {
          "$ref": "common.schema.json#/$defs/attribution"
        },
        "created_at": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "preparation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "preparation_id",
        "repository_id",
        "material_id",
        "material_digest",
        "base_image",
        "database_id",
        "host_id",
        "data_root",
        "input_digest",
        "request_digest",
        "engine_id",
        "platform",
        "builder",
        "state",
        "attribution",
        "created_at"
      ],
      "properties": {
        "format": {
          "const": "grounds.repository-image-preparation/v1"
        },
        "preparation_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "repository_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "material_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "material_digest": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "base_image": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "database_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "host_id": {
          "type": "string",
          "format": "uuid"
        },
        "data_root": {
          "type": "string",
          "minLength": 1
        },
        "input_digest": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "request_digest": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "engine_id": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "builder": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "registered",
            "blocked",
            "building",
            "needs-recovery",
            "ready",
            "failed",
            "cancelled"
          ]
        },
        "attribution": {
          "$ref": "common.schema.json#/$defs/attribution"
        },
        "created_at": {
          "type": "string",
          "minLength": 1
        },
        "image": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "reused": {
          "type": "boolean"
        },
        "producer_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "cancellation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation_id",
            "attribution",
            "requested_at"
          ],
          "properties": {
            "operation_id": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "attribution": {
              "$ref": "common.schema.json#/$defs/attribution"
            },
            "requested_at": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "cleanup": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation_id",
            "attribution",
            "state"
          ],
          "properties": {
            "operation_id": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "attribution": {
              "$ref": "common.schema.json#/$defs/attribution"
            },
            "state": {
              "enum": [
                "pending",
                "complete"
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "ready"
              }
            }
          },
          "then": {
            "required": [
              "image",
              "reused",
              "producer_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "cancelled"
              }
            }
          },
          "then": {
            "required": [
              "cancellation"
            ]
          }
        },
        {
          "if": {
            "required": [
              "cleanup"
            ]
          },
          "then": {
            "properties": {
              "state": {
                "enum": [
                  "ready",
                  "failed",
                  "cancelled"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
