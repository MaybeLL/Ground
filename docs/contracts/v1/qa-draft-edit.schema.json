{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grounds.dev/contracts/v1/qa-draft-edit.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 1024
        },
        "question": {
          "type": "string",
          "maxLength": 65536
        },
        "instructions": {
          "type": "string",
          "maxLength": 65536
        },
        "rubric": {
          "type": "string",
          "maxLength": 65536
        },
        "reference_answer": {
          "type": "string",
          "maxLength": 65536
        },
        "required_points": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
          },
          "maxItems": 1000
        },
        "forbidden_claims": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
          },
          "maxItems": 1000
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
          },
          "maxItems": 1000
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "pending",
            "reviewed",
            "ignored",
            "not_applicable"
          ]
        },
        "knowledge": {
          "enum": [
            "unknown",
            "stable",
            "historical"
          ]
        },
        "independent_text": {
          "type": "boolean"
        },
        "attachments_resolved": {
          "type": "boolean"
        },
        "authority": {
          "type": "string",
          "maxLength": 65536
        },
        "answer_conditions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "accessible": {
              "type": "boolean"
            },
            "preserves_question": {
              "type": "boolean"
            },
            "locator": {
              "type": "string",
              "maxLength": 65536
            },
            "instructions": {
              "type": "string",
              "maxLength": 65536
            }
          },
          "required": [
            "accessible",
            "preserves_question",
            "locator",
            "instructions"
          ]
        }
      },
      "required": [
        "status",
        "knowledge",
        "independent_text",
        "attachments_resolved",
        "authority"
      ]
    }
  }
}
