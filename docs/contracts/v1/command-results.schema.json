{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patchledger.dev/contracts/v1/command-results.schema.json",
  "title": "Grounds CLI 命令结果 v1",
  "oneOf": [
    { "$ref": "#/$defs/developmentDefaultResult" },
    { "$ref": "repository-archive.schema.json" },
    {
      "$ref": "development-collaboration.schema.json"
    },
    {
      "$ref": "environment.schema.json"
    },
    {
      "$ref": "#/$defs/helpResult"
    },
    {
      "$ref": "#/$defs/versionResult"
    },
    {
      "$ref": "#/$defs/doctorResult"
    },
    {
      "$ref": "#/$defs/candidateTemplateResult"
    },
    {
      "$ref": "#/$defs/verificationTemplateResult"
    },
    {
      "$ref": "#/$defs/verificationHandoffResult"
    },
    {
      "$ref": "#/$defs/qualityTemplateResult"
    },
    {
      "$ref": "#/$defs/qualityHandoffResult"
    },
    {
      "$ref": "#/$defs/independentDigestResult"
    },
    {
      "$ref": "#/$defs/skillInstallResult"
    },
    {
      "$ref": "#/$defs/initResult"
    },
    {
      "$ref": "#/$defs/configShowResult"
    },
    {
      "$ref": "#/$defs/configPathResult"
    },
    {
      "$ref": "#/$defs/configValidateResult"
    },
    {
      "$ref": "#/$defs/databaseResult"
    },
    {
      "$ref": "#/$defs/repositoryResult"
    },
    {
      "$ref": "#/$defs/devRunContextResult"
    },
    {
      "$ref": "#/$defs/devRunMutationResult"
    },
    {
      "$ref": "#/$defs/devRunWorktreeCleanupResult"
    },
    {
      "$ref": "#/$defs/candidateSubmitResult"
    },
    {
      "$ref": "#/$defs/candidateMaterializeResult"
    },
    {
      "$ref": "#/$defs/verificationContextResult"
    },
    {
      "$ref": "#/$defs/verificationSubmitResult"
    },
    {
      "$ref": "verification-run.schema.json"
    },
    {
      "$ref": "#/$defs/listResult"
    },
    {
      "$ref": "query-results.schema.json"
    },
    {
      "$ref": "preflight.schema.json"
    },
    {
      "$ref": "#/$defs/workspaceInputResult"
    }
  ],
  "$defs": {
    "versionReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "helpResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_type", "command", "usage"],
      "properties": {
        "result_type": { "const": "patchledger.result.help/v1" },
        "command": { "const": "help" },
        "usage": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "versionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_type", "command", "version"],
      "properties": {
        "result_type": { "const": "patchledger.result.version/v1" },
        "command": { "const": "version" },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "doctorResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_type", "command", "cli", "skills", "upgrade_required", "recommended_commands"],
      "properties": {
        "result_type": { "const": "patchledger.result.doctor/v1" },
        "command": { "const": "doctor" },
        "cli": {
          "type": "object", "additionalProperties": false,
          "required": ["installed_version", "status"],
          "properties": {
            "installed_version": { "type": "string", "minLength": 1, "maxLength": 128 },
            "registry_version": { "type": "string", "minLength": 1, "maxLength": 128 },
            "status": { "enum": ["current", "outdated", "ahead", "unknown"] }
          }
        },
        "skills": {
          "type": "object", "additionalProperties": false,
          "required": ["target_path", "status", "details"],
          "properties": {
            "target_path": { "type": "string", "minLength": 1, "maxLength": 32768 },
            "installed_version": { "type": "string", "minLength": 1, "maxLength": 128 },
            "status": { "enum": ["current", "outdated", "ahead", "unknown", "missing", "mixed"] },
            "details": {
              "type": "array", "minItems": 1, "maxItems": 1,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["name", "status"],
                "properties": {
                  "name": {
                    "const": "grounds"
                  },
                  "status": { "enum": ["current", "outdated", "ahead", "unknown", "missing"] },
                  "installed_version": { "type": "string", "minLength": 1, "maxLength": 128 }
                }
              }
            }
          }
        },
        "upgrade_required": { "type": "boolean" },
        "recommended_commands": { "type": "array", "maxItems": 2, "items": { "type": "string", "minLength": 1, "maxLength": 32768 } }
      }
    },
    "candidateTemplateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_type", "command", "dev_run_id", "submission"],
      "properties": {
        "result_type": { "const": "patchledger.result.candidate-template/v1" },
        "command": { "const": "candidate.template" },
        "dev_run_id": { "$ref": "common.schema.json#/$defs/id" },
        "change_index": { "$ref": "common.schema.json#/$defs/changeIndex" },
        "submission": { "type": "object" }
      }
    },
    "verificationTemplateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_type", "command", "candidate_id", "blind_context_digest", "result_tree_oid", "report"],
      "properties": {
        "result_type": { "const": "patchledger.result.verification-template/v1" },
        "command": { "const": "verification.template" },
        "candidate_id": { "$ref": "common.schema.json#/$defs/id" },
        "blind_context_digest": { "$ref": "common.schema.json#/$defs/sha256" },
        "result_tree_oid": { "$ref": "common.schema.json#/$defs/gitOid" },
        "report": { "type": "object" }
      }
    },
    "verificationHandoffResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_type", "command", "candidate_id", "report_digest", "handoff"],
      "properties": {
        "result_type": { "const": "patchledger.result.verification-handoff/v1" },
        "command": { "const": "verification.handoff" },
        "candidate_id": { "$ref": "common.schema.json#/$defs/id" },
        "report_digest": { "$ref": "common.schema.json#/$defs/sha256" },
        "independent_digest": { "$ref": "common.schema.json#/$defs/sha256" },
        "handoff": { "$ref": "verification-handoff.schema.json" },
        "output_path": { "type": "string", "minLength": 1, "maxLength": 32768 }
      }
    },
    "qualityTemplateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_type", "command", "candidate_id", "blind_context_digest", "result_tree_oid", "report"],
      "properties": {
        "result_type": { "const": "patchledger.result.quality-template/v1" },
        "command": { "const": "verification.template" },
        "candidate_id": { "$ref": "common.schema.json#/$defs/id" },
        "blind_context_digest": { "$ref": "common.schema.json#/$defs/sha256" },
        "result_tree_oid": { "$ref": "common.schema.json#/$defs/gitOid" },
        "report": { "$ref": "quality-review-report.schema.json" }
      }
    },
    "qualityHandoffResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_type", "command", "candidate_id", "report_digest", "independent_digest", "handoff"],
      "properties": {
        "result_type": { "const": "patchledger.result.quality-handoff/v1" },
        "command": { "const": "verification.handoff" },
        "candidate_id": { "$ref": "common.schema.json#/$defs/id" },
        "report_digest": { "$ref": "common.schema.json#/$defs/sha256" },
        "independent_digest": { "$ref": "common.schema.json#/$defs/sha256" },
        "handoff": { "$ref": "quality-review-handoff.schema.json" },
        "output_path": { "type": "string", "minLength": 1, "maxLength": 32768 }
      }
    },
    "independentDigestResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_type", "command", "candidate_id", "report_format", "independent_digest"],
      "properties": {
        "result_type": { "const": "patchledger.result.independent-digest/v1" },
        "command": { "const": "verification.independent-digest" },
        "candidate_id": { "$ref": "common.schema.json#/$defs/id" },
        "report_format": { "enum": ["patchledger.verification-report/v1", "patchledger.quality-review-report/v1"] },
        "independent_digest": { "$ref": "common.schema.json#/$defs/sha256" }
      }
    },
    "skillInstallResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_type", "command", "target_path", "skills"],
      "properties": {
        "result_type": { "const": "patchledger.result.skill-install/v1" },
        "command": { "const": "install.skill" },
        "target_path": { "type": "string", "minLength": 1, "maxLength": 32768 },
        "skills": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "path"],
            "properties": {
              "name": {
                "const": "grounds"
              },
              "path": { "type": "string", "minLength": 1, "maxLength": 32768 }
            }
          }
        }
      }
    },
    "initResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_type", "command", "driver", "database_id", "database_action", "config_path"],
      "properties": {
        "result_type": { "const": "patchledger.result.init/v1" },
        "command": { "const": "init" },
        "driver": { "enum": ["sqlite", "mysql"] },
        "database_id": { "$ref": "common.schema.json#/$defs/id" },
        "database_action": { "enum": ["initialized", "attached"] },
        "config_path": { "type": "string", "minLength": 1, "maxLength": 32768 }
      }
    },
    "developmentDefaultResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_type", "command", "mode"],
      "properties": {
        "result_type": { "const": "grounds.result.development-default/v1" },
        "command": { "const": "config.set-development-mode" },
        "mode": { "enum": ["simple", "container"] }
      }
    },
    "configShowResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_type", "command", "config"],
      "properties": {
        "result_type": { "const": "patchledger.result.config-show/v1" },
        "command": { "const": "config.show" },
        "config": { "$ref": "config.schema.json" }
      }
    },
    "configPathResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_type", "command", "config_path"],
      "properties": {
        "result_type": { "const": "patchledger.result.config-path/v1" },
        "command": { "const": "config.path" },
        "config_path": { "type": "string", "minLength": 1, "maxLength": 32768 }
      }
    },
    "configValidateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_type", "command", "valid"],
      "properties": {
        "result_type": { "const": "patchledger.result.config-validate/v1" },
        "command": { "const": "config.validate" },
        "valid": { "const": true }
      }
    },
    "databaseResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_type", "command", "database_id", "schema_version", "protocol_version", "remote_normalization_version", "baseline_reachability_policy", "migration_state"],
      "properties": {
        "result_type": { "const": "patchledger.result.database/v1" },
        "command": { "enum": ["db.test", "db.status", "db.migrate"] },
        "database_id": { "$ref": "common.schema.json#/$defs/id" },
        "schema_version": { "type": "integer", "minimum": 0 },
        "protocol_version": { "type": "integer", "minimum": 0 },
        "remote_normalization_version": { "type": "integer", "minimum": 0 },
        "baseline_reachability_policy": { "enum": ["warn", "require_override"] },
        "migration_state": { "enum": ["clean", "dirty", "in_progress"] },
        "integrity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["valid", "issues"],
          "properties": {
            "valid": { "type": "boolean" },
            "issues": {
              "type": "array",
              "maxItems": 1000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["check", "reason"],
                "properties": {
                  "check": { "type": "string", "minLength": 1, "maxLength": 128 },
                  "resource_type": { "type": "string", "minLength": 1, "maxLength": 128 },
                  "resource_id": { "$ref": "common.schema.json#/$defs/id" },
                  "reason": { "type": "string", "minLength": 1, "maxLength": 4096 }
                }
              }
            }
          }
        }
      }
    },
    "repositoryResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_type", "command", "repository_id", "version", "canonical_remote"],
      "properties": {
        "result_type": { "const": "patchledger.result.repository/v1" },
        "command": { "enum": ["repository.register", "repository.resolve", "repository.move", "repository.alias-add", "repository.alias-retire"] },
        "repository_id": { "$ref": "common.schema.json#/$defs/id" },
        "version": { "type": "integer", "minimum": 1 },
        "canonical_remote": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "devRunContextResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_type", "command", "context"],
      "properties": {
        "result_type": { "const": "patchledger.result.devrun-context/v1" },
        "command": { "enum": ["devrun.start", "devrun.context"] },
        "context": { "$ref": "devrun-context.schema.json" },
        "local_worktree": { "$ref": "#/$defs/localWorktree" },
        "prepare_only": { "const": true },
        "preflight": { "$ref": "preflight.schema.json#/$defs/devRunPreflight" }
      }
    },
    "localWorktree": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "path"
          ],
          "properties": {
            "status": {
              "const": "available"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32768
            },
            "ownership": {
              "const": "external"
            },
            "input_digest": {
              "$ref": "common.schema.json#/$defs/sha256"
            },
            "initial_changes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "initial_result_tree_oid": {
              "$ref": "common.schema.json#/$defs/gitOid"
            },
            "development": {
              "$ref": "development-collaboration.schema.json#/$defs/developmentIdentity"
            },
            "head": {
              "$ref": "common.schema.json#/$defs/gitOid"
            },
            "base_commit": {
              "$ref": "common.schema.json#/$defs/gitOid"
            },
            "active_dev_run_id": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "owner_phase": {
              "enum": [
                "active",
                "pending"
              ]
            },
            "continuation": {
              "enum": [
                "developing",
                "paused",
                "parallel"
              ]
            },
            "working_tree_dirty": {
              "type": "boolean"
            },
            "git_operation_in_progress": {
              "type": "boolean"
            },
            "initial_base_commit": {
              "$ref": "common.schema.json#/$defs/gitOid"
            },
            "definition_commit": {
              "$ref": "common.schema.json#/$defs/gitOid"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason"
          ],
          "properties": {
            "status": {
              "const": "missing"
            },
            "reason": {
              "enum": [
                "not_available_on_this_machine",
                "local_worktree_deleted"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason"
          ],
          "properties": {
            "status": {
              "const": "invalid"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "removed"
            }
          }
        }
      ]
    },
    "devRunWorktreeCleanupResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_type",
        "command",
        "dev_run_id",
        "removed",
        "local_worktree"
      ],
      "properties": {
        "result_type": {
          "const": "patchledger.result.devrun-worktree-cleanup/v1"
        },
        "command": {
          "const": "devrun.cleanup"
        },
        "dev_run_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "removed": {
          "type": "boolean"
        },
        "local_worktree": {
          "$ref": "#/$defs/localWorktree"
        },
        "external_preserved": {
          "const": true
        },
        "deletion_summary": {
          "$ref": "#/$defs/devRunDeletionSummary"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "removed": { "const": true } }, "required": ["removed"] },
          "then": { "required": ["deletion_summary"] },
          "else": { "not": { "required": ["deletion_summary"] } }
        }
      ]
    },
    "devRunDeletionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dev_run_id", "worktree_path", "discard_changes", "entry_count", "occurred_at"],
      "properties": {
        "dev_run_id": { "$ref": "common.schema.json#/$defs/id" },
        "worktree_path": { "type": "string", "minLength": 1, "maxLength": 32768 },
        "discard_changes": { "type": "boolean" },
        "entry_count": { "type": "integer", "minimum": 0 },
        "occurred_at": { "$ref": "common.schema.json#/$defs/timestamp" }
      }
    },
    "devRunMutationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_type", "command", "dev_run_id", "version", "state"],
      "properties": {
        "result_type": { "const": "patchledger.result.devrun-mutation/v1" },
        "command": { "const": "devrun.abandon" },
        "dev_run_id": { "$ref": "common.schema.json#/$defs/id" },
        "version": { "type": "integer", "minimum": 2 },
        "state": { "const": "abandoned" }
      }
    },
    "candidateSubmitResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_type", "command", "candidate_id", "dev_run_id", "issue", "result_tree_oid", "patch_digest", "created_at"],
      "properties": {
        "git_artifact": { "$ref": "candidate-archive.schema.json#/$defs/artifact" },
        "result_type": { "const": "patchledger.result.candidate-submit/v1" },
        "command": { "const": "candidate.submit" },
        "candidate_id": { "$ref": "common.schema.json#/$defs/id" },
        "dev_run_id": { "$ref": "common.schema.json#/$defs/id" },
        "issue": { "$ref": "#/$defs/versionReference" },
        "result_tree_oid": { "$ref": "common.schema.json#/$defs/gitOid" },
        "patch_digest": { "$ref": "common.schema.json#/$defs/sha256" },
        "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "source": {
          "$ref": "development-collaboration.schema.json#/$defs/sourceIdentity"
        }
      }
    },
    "candidateMaterializeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_type", "command", "candidate_id", "result_tree_oid", "target_path", "materialization_mode"],
      "properties": {
        "result_type": { "const": "patchledger.result.candidate-materialize/v1" },
        "command": { "const": "candidate.materialize" },
        "candidate_id": { "$ref": "common.schema.json#/$defs/id" },
        "result_tree_oid": { "$ref": "common.schema.json#/$defs/gitOid" },
        "target_path": { "type": "string", "minLength": 1, "maxLength": 32768 },
        "materialization_mode": { "enum": ["existing", "review"] },
        "review_session_id": { "$ref": "common.schema.json#/$defs/id" }
      },
      "allOf": [
        {
          "if": { "required": ["review_session_id"] },
          "then": { "properties": { "materialization_mode": { "const": "review" } } }
        }
      ]
    },
    "verificationContextResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_type", "command", "context"],
      "properties": {
        "result_type": { "const": "patchledger.result.verification-context/v1" },
        "command": { "const": "verification.context" },
        "context": {
          "oneOf": [
            { "$ref": "verification-context.schema.json" },
            { "$ref": "quality-context.schema.json" }
          ]
        },
        "output_path": { "type": "string", "minLength": 1, "maxLength": 32768 }
      }
    },
    "verificationSubmitResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_type", "command", "verification_id", "candidate_id", "overall_verdict", "standing", "created_at"],
      "properties": {
        "result_type": { "const": "patchledger.result.verification-submit/v1" },
        "command": { "const": "verification.submit" },
        "verification_id": { "$ref": "common.schema.json#/$defs/id" },
        "candidate_id": { "$ref": "common.schema.json#/$defs/id" },
        "mode": { "$ref": "common.schema.json#/$defs/verificationMode" },
        "overall_verdict": { "$ref": "common.schema.json#/$defs/verdict" },
        "standing": { "$ref": "common.schema.json#/$defs/standing" },
        "created_at": { "$ref": "common.schema.json#/$defs/timestamp" }
      }
    },
    "listResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_type",
        "command",
        "resources"
      ],
      "properties": {
        "result_type": {
          "const": "patchledger.result.resource-list/v1"
        },
        "command": {
          "enum": [
            "repository.list",
            "requirement.list",
            "issue.list",
            "devrun.list",
            "candidate.list",
            "verification.list"
          ]
        },
        "resources": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "resource_type",
              "resource_id",
              "label"
            ],
            "properties": {
              "resource_type": {
                "enum": [
                  "repository",
                  "requirement",
                  "issue",
                  "dev_run",
                  "candidate",
                  "verification",
                  "ledger_event"
                ]
              },
              "resource_id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "version": {
                "type": "integer",
                "minimum": 1
              },
              "created_at": { "type": "string", "format": "date-time" },
              "last_activity": {
                "type": ["object", "null"], "additionalProperties": false,
                "required": ["occurred_at", "kind", "issue_version"],
                "properties": {
                  "occurred_at": { "type": "string", "format": "date-time" },
                  "kind": { "enum": ["published", "devrun_started", "devrun_abandoned", "candidate", "verification", "selection", "completion"] },
                  "issue_version": { "type": "integer", "minimum": 1 }
                }
              },
              "requirement": {
                "type": "object", "additionalProperties": false, "required": ["id", "version"],
                "properties": { "id": { "$ref": "common.schema.json#/$defs/id" }, "version": { "type": "integer", "minimum": 1 } }
              },
              "repository": {
                "type": "object", "additionalProperties": false, "required": ["id", "canonical_remote"],
                "properties": { "id": { "$ref": "common.schema.json#/$defs/id" }, "canonical_remote": { "type": "string", "minLength": 1, "maxLength": 4096 } }
              },
              "issue": {
                "type": "object", "additionalProperties": false, "required": ["id", "version"],
                "properties": { "id": { "$ref": "common.schema.json#/$defs/id" }, "version": { "type": "integer", "minimum": 1 } }
              },
              "candidate_id": { "$ref": "common.schema.json#/$defs/id" },
              "overall_verdict": { "enum": ["qualified", "rejected", "inconclusive"] },
              "mode": { "$ref": "common.schema.json#/$defs/verificationMode" },
              "quality_verdict": { "$ref": "common.schema.json#/$defs/verdict" },
              "quality_attribution": { "$ref": "common.schema.json#/$defs/attribution" },
              "board": {
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "next_action",
    "open_dev_run_count",
    "candidate_count",
    "selection",
    "completion"
  ],
  "properties": {
    "status": {
      "enum": [
        "ready",
        "exploring",
        "candidates_available",
        "candidate_selected",
        "completed"
      ]
    },
    "next_action": {
      "enum": [
        "start_devrun",
        "resume_devrun",
        null
      ]
    },
    "open_dev_run_count": {
      "type": "integer",
      "minimum": 0
    },
    "candidate_count": {
      "type": "integer",
      "minimum": 0
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "version"
      ],
      "properties": {
        "state": {
          "enum": [
            "selected",
            "unselected"
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "candidate_id": {
          "$ref": "common.schema.json#/$defs/id"
        }
      }
    },
    "completion": {
      "$ref": "completion.schema.json#/$defs/view"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "properties": {
          "next_action": {
            "const": null
          }
        }
      }
    }
  ]
},
              "progress": {
  "type": "object",
  "additionalProperties": false,
  "required": [
    "issue_count",
    "ready_issue_count",
    "open_dev_run_count",
    "candidate_count",
    "completion_status",
    "completed_issue_count",
    "bound_to_selected_version_issue_count"
  ],
  "properties": {
    "issue_count": {
      "type": "integer",
      "minimum": 0
    },
    "ready_issue_count": {
      "type": "integer",
      "minimum": 0
    },
    "open_dev_run_count": {
      "type": "integer",
      "minimum": 0
    },
    "candidate_count": {
      "type": "integer",
      "minimum": 0
    },
    "completion_status": {
      "enum": [
        "completed",
        "incomplete",
        "no_issues"
      ]
    },
    "completed_issue_count": {
      "type": "integer",
      "minimum": 0
    },
    "bound_to_selected_version_issue_count": {
      "type": "integer",
      "minimum": 0
    }
  }
},
              "state": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "is_selected": {
                "type": "boolean"
              }
            }
          }
        },
        "next_cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "query": {
          "type": "object",
          "description": "回显 CLI 实际使用的准确筛选与排序，便于解释空列表或看似部分的结果。",
          "additionalProperties": { "type": ["string", "boolean", "integer"] }
        },
        "page": {
          "type": "object",
          "description": "仅在调用者请求游标分页（--limit 和/或 --cursor）时存在；没有此字段则列表为完整集合。",
          "additionalProperties": false,
          "required": ["limit", "has_more", "sort"],
          "properties": {
            "limit": { "type": "integer", "minimum": 1, "maximum": 1000 },
            "has_more": { "type": "boolean" },
            "sort": { "enum": ["id:asc", "activity:desc,id:asc", "created_at:asc,id:asc"] }
          }
        }
      }
    },
    "workspaceInputResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_type",
        "command",
        "workspace"
      ],
      "properties": {
        "result_type": {
          "const": "patchledger.result.workspace-input/v1"
        },
        "command": {
          "const": "devrun.inspect-workspace"
        },
        "workspace": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "directory",
            "identity",
            "baseline_oid",
            "input_digest",
            "result_tree_oid",
            "changes",
            "dirty"
          ],
          "properties": {
            "directory": {
              "type": "string",
              "minLength": 1
            },
            "identity": {
              "type": "string",
              "pattern": "^\\d+:\\d+$"
            },
            "baseline_oid": {
              "$ref": "common.schema.json#/$defs/gitOid"
            },
            "input_digest": {
              "$ref": "common.schema.json#/$defs/sha256"
            },
            "result_tree_oid": {
              "$ref": "common.schema.json#/$defs/gitOid"
            },
            "dirty": {
              "type": "boolean"
            },
            "changes": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 65536
            }
          }
        }
      }
    }
  }
}
