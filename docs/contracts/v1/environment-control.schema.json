{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patchledger.dev/contracts/v1/environment-control.schema.json",
  "title": "Grounds environment readiness checks and explicit Repo defaults",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_type",
        "command",
        "check"
      ],
      "properties": {
        "result_type": {
          "const": "grounds.result.environment-control/v1"
        },
        "command": {
          "enum": [
            "code-workspace.environment-check",
            "code-workspace.environment-check-show"
          ]
        },
        "check": {
          "$ref": "#/$defs/check"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_type",
        "command",
        "default"
      ],
      "properties": {
        "result_type": {
          "const": "grounds.result.environment-control/v1"
        },
        "command": {
          "enum": [
            "code-workspace.environment-set-default",
            "code-workspace.environment-default"
          ]
        },
        "default": {
          "$ref": "#/$defs/default"
        }
      }
    }
  ],
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "check_id",
        "route_id",
        "database_id",
        "host_id",
        "environment",
        "request_digest",
        "profile",
        "argv",
        "state",
        "attribution",
        "created_at"
      ],
      "properties": {
        "format": {
          "const": "grounds.repository-environment-check/v1"
        },
        "check_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "route_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "database_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "host_id": {
          "type": "string",
          "format": "uuid"
        },
        "environment": {
          "$ref": "repository-environment.schema.json#/$defs/version"
        },
        "request_digest": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "profile": {
          "const": "git-python-postgres-connect/v1"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "state": {
          "enum": [
            "registered",
            "checking",
            "needs-recovery",
            "passed",
            "failed"
          ]
        },
        "engine_id": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "exit_code": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "enum": [
            "execution-needs-recovery",
            "probe-failed",
            "stopped-without-result"
          ]
        },
        "attribution": {
          "$ref": "common.schema.json#/$defs/attribution"
        },
        "created_at": {
          "type": "string"
        },
        "completed_at": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "passed"
              }
            }
          },
          "then": {
            "required": [
              "engine_id",
              "platform",
              "exit_code",
              "completed_at"
            ],
            "properties": {
              "exit_code": {
                "const": 0
              }
            },
            "not": {
              "required": [
                "reason"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "failed"
              }
            }
          },
          "then": {
            "required": [
              "completed_at",
              "reason"
            ]
          }
        }
      ]
    },
    "default": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "repository_id",
        "revision_id",
        "check_id",
        "version",
        "attribution",
        "selected_at"
      ],
      "properties": {
        "format": {
          "const": "grounds.repository-environment-default/v1"
        },
        "repository_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "revision_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "check_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "attribution": {
          "$ref": "common.schema.json#/$defs/attribution"
        },
        "selected_at": {
          "type": "string"
        }
      }
    }
  }
}
