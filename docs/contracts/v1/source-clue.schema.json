{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grounds.dev/contracts/v1/source-clue.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "grounds.source-clue/v1"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 1024,
          "minLength": 1
        },
        "root": {
          "type": "string",
          "maxLength": 4096,
          "minLength": 1
        }
      },
      "required": [
        "id",
        "root"
      ]
    },
    "clues": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/clue"
      }
    }
  },
  "required": [
    "format",
    "project",
    "clues"
  ],
  "$defs": {
    "clue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 1024,
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "maxLength": 1024,
          "minLength": 1
        },
        "host": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        },
        "session": {
          "type": "string",
          "maxLength": 1024,
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "maxLength": 1024
        },
        "reason": {
          "type": "string",
          "maxLength": 1024,
          "minLength": 1
        },
        "state": {
          "const": "pending_analysis"
        },
        "record_ref": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 1024,
              "minLength": 1
            },
            "kind": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "required": [
            "id",
            "kind",
            "digest"
          ]
        },
        "first_captured_at": {
          "type": "string",
          "format": "date-time",
          "maxLength": 128
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "maxLength": 128
        },
        "limitations": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 4096,
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "project_id",
        "host",
        "session",
        "branch",
        "reason",
        "state",
        "record_ref",
        "first_captured_at",
        "expires_at",
        "limitations"
      ]
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 1024,
          "minLength": 1
        },
        "root": {
          "type": "string",
          "maxLength": 4096,
          "minLength": 1
        }
      },
      "required": [
        "id",
        "root"
      ]
    }
  }
}
