{
  "name": "@maybell/grounds",
  "version": "0.3.0",
  "description": "Grounds CLI for evidence-backed human and Agent work",
  "type": "module",
  "files": [
    "dist/",
    "README.md",
    "binding.gyp",
    "native/",
    "vendor/",
    "prebuilds/"
  ],
  "bin": {
    "grounds": "dist/src/bin.js"
  },
  "scripts": {
    "build": "npm run build:native && node scripts/clean.mjs && tsc -p tsconfig.json && node scripts/bundle-skills.mjs",
    "dev": "tsx src/main.ts",
    "start": "node dist/src/main.js",
    "test": "node --test scripts/test-environment.test.mjs && node scripts/test-parallel.mjs",
    "test:coverage": "node --import tsx --test --test-concurrency=1 --experimental-test-coverage test/*.test.ts",
    "test:brand": "node ../scripts/brand-audit.mjs",
    "test:package": "npm run build && node scripts/package-test.mjs",
    "prepublishOnly": "node -e \"throw new Error('Publish verified GitHub Release tarballs; see docs/releases.md')\"",
    "test:serial": "node scripts/test-parallel.mjs --workers 1",
    "release:check": "node ../scripts/github-release-check.mjs",
    "build:native": "node scripts/build-native.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1137.0",
    "@devcontainers/cli": "0.90.0",
    "jsonc-parser": "3.3.1",
    "mysql2": "^3.24.2",
    "pg": "^8.23.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaybeLL/Ground.git",
    "directory": "typescript"
  },
  "homepage": "https://github.com/MaybeLL/Ground",
  "bugs": {
    "url": "https://github.com/MaybeLL/Ground/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "gypfile": false
}
