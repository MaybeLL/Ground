{
  "name": "@maybell/grounds",
  "version": "0.2.49",
  "description": "Grounds CLI for evidence-backed human and Agent work",
  "type": "module",
  "files": [
    "dist/",
    "README.md",
    "binding.gyp",
    "native/",
    "vendor/"
  ],
  "bin": {
    "grounds": "dist/src/bin.js"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && node scripts/bundle-skills.mjs",
    "dev": "tsx src/main.ts",
    "start": "node dist/src/main.js",
    "test": "node --test scripts/test-environment.test.mjs && node scripts/test-parallel.mjs",
    "test:coverage": "node --import tsx --test --test-concurrency=1 --experimental-test-coverage test/*.test.ts",
    "test:brand": "node ../scripts/brand-audit.mjs",
    "test:package": "npm run build && node scripts/package-test.mjs",
    "prepublishOnly": "node -e \"throw new Error('Use the GitHub Releases workflow; npm registry publication is disabled')\"",
    "test:serial": "node scripts/test-parallel.mjs --workers 1",
    "test:code-workspace": "node scripts/test-code-workspace.mjs",
    "test:workspace-compatibility": "node scripts/test-workspace-compatibility.mjs",
    "release:check": "node ../scripts/github-release-check.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1137.0",
    "fs-ext": "^2.1.1",
    "marked": "^17.0.6",
    "mysql2": "^3.24.2",
    "node-pty": "1.1.0",
    "pg": "^8.23.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/fs-ext": "^2.0.3",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "playwright": "^1.63.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaybeLL/grounds-open.git",
    "directory": "typescript"
  },
  "homepage": "https://github.com/MaybeLL/grounds-open",
  "bugs": {
    "url": "https://github.com/MaybeLL/grounds-open/issues"
  },
  "license": "MIT"
}
