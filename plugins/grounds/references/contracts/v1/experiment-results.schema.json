    "Batch": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "work-results.schema.json#/$defs/Id"
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "experimentId": {
          "$ref": "work-results.schema.json#/$defs/Id"
        },
        "suite": {
          "$ref": "work-results.schema.json#/$defs/RevisionRef"
        },
        "agent": {
          "$ref": "work-results.schema.json#/$defs/RevisionRef"
        },
        "repeatCount": {
          "type": "integer",
          "minimum": 0
        },
        "taskConcurrency": {
          "type": "integer",
          "minimum": 0
