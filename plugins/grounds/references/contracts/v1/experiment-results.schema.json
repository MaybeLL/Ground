        "counts",
        "dimensions",
        "members"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "command": {
          "const": "experiment.member"
        },
        "result_type": {
          "const": "grounds.result.experiment.member/v1"
