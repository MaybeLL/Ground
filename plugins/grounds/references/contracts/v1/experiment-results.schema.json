        },
        "executions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "key",
        "caseKey",
        "repeatIndex",
        "runId",
        "status",
        "complete",
        "requirements",
        "gradings",
        "executions"
      ],
      "additionalProperties": false
    }
