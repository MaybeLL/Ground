          "$ref": "work-results.schema.json#/$defs/Id"
        }
      },
      "required": [
        "command",
        "result_type",
        "batchId"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "command": {
          "const": "experiment.regrade"
        },
        "result_type": {
          "const": "grounds.result.experiment.regrade/v1"
        },
        "gradingId": {
          "$ref": "work-results.schema.json#/$defs/Id"
        },
        "suiteId": {
          "$ref": "work-results.schema.json#/$defs/Id"
        },
        "revisionId": {
          "$ref": "work-results.schema.json#/$defs/Id"
        },
        "caseKey": {
          "$ref": "work-results.schema.json#/$defs/Id"
        },
        "runId": {
          "$ref": "work-results.schema.json#/$defs/Id"
        },
        "deliveryId": {
          "$ref": "work-results.schema.json#/$defs/Id"
        },
        "bindingKey": {
          "$ref": "work-results.schema.json#/$defs/Id"
