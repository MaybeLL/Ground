            "type": "object",
            "properties": {
              "experimentId": {
                "$ref": "work-results.schema.json#/$defs/Id"
              },
              "batchId": {
                "$ref": "work-results.schema.json#/$defs/Id"
              },
              "memberCount": {
                "type": "integer",
