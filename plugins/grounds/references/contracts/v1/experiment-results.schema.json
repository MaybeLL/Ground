        "command",
        "result_type",
        "batchId"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "command": {
          "const": "experiment.resume"
        },
        "result_type": {
          "const": "grounds.result.experiment.resume/v1"
        },
