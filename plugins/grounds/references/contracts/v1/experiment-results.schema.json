          "$ref": "work-results.schema.json#/$defs/Id"
        },
        "suiteId": {
          "$ref": "work-results.schema.json#/$defs/Id"
        },
        "revisionId": {
          "$ref": "work-results.schema.json#/$defs/Id"
        },
        "caseKey": {
          "$ref": "work-results.schema.json#/$defs/Id"
        },
        "runId": {
          "$ref": "work-results.schema.json#/$defs/Id"
        },
        "deliveryId": {
          "$ref": "work-results.schema.json#/$defs/Id"
