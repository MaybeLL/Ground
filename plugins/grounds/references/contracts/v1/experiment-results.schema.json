        },
        "repeatIndex": {
          "type": "integer",
          "minimum": 0
        },
        "runId": {
          "type": [
            "null",
            "string"
          ]
        },
        "status": {
          "type": "string"
        },
        "complete": {
          "type": "boolean"
        },
        "gradingNotStarted": {
          "type": "string"
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "$ref": "work-results.schema.json#/$defs/Id"
              },
              "adopted": {
                "$ref": "work-results.schema.json#/$defs/Id"
              },
              "latestFault": {
