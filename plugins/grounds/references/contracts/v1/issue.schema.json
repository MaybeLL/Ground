{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patchledger.dev/contracts/v1/issue.schema.json",
  "title": "Grounds Issue YAML v1 契约",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "summary", "goals"],
  "properties": {
    "format": { "const": 1 },
    "target_branch": { "$ref": "#/$defs/targetBranch" },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "context": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "plan": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "description": "非规范：Issue 的整体方案说明，供开发与阅读参考，不产生验收义务；有约束力的内容必须写入带 Criteria 的 goals 或 constraints。省略即不存在，空串或纯空白不合法。"
    },
    "goals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/targetInput" }
    },
    "constraints": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/constraintInput" }
    }
  },
  "$defs": {
    "targetBranch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["remote", "ref"],
      "properties": {
        "remote": { "type": "string", "minLength": 1, "maxLength": 256 },
        "ref": { "type": "string", "minLength": 12, "maxLength": 1024, "pattern": "^refs/heads/" }
      }
    },
    "targetInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "criteria"],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "guidance": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "traces_to": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/intentLink" }
        }
      }
    },
    "constraintInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "criteria"],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "guidance": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "traces_to": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/intentLink" }
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        }
      }
    }
  }
}
