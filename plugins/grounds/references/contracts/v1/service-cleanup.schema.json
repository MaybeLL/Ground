    "volumePreview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "instance_id",
        "route_id",
        "execution_id",
        "lifecycle_version",
        "lifecycle_gate",
        "observed_at",
        "deletion_supported",
        "source",
        "archives",
        "restorations"
      ],
      "properties": {
        "scope": {
          "const": "route_volumes"
        },
        "instance_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "route_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "execution_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "lifecycle_version": {
          "type": "integer",
          "minimum": 1
        },
        "lifecycle_gate": {
          "enum": [
            "ready",
            "retention",
            "pinned"
          ]
        },
        "observed_at": {
          "type": "string",
          "minLength": 1
        },
        "deletion_supported": {
          "const": true
        },
        "source": {
          "$ref": "#/$defs/protectedVolume"
        },
        "archives": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/volumeArchiveStatus"
