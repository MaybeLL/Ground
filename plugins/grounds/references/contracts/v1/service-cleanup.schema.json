          "$ref": "#/$defs/retainedVolume"
        },
        "startup_verified": {
          "type": "boolean"
        },
        "business_status": {
          "enum": [
            "passed",
            "failed",
            "not_requested",
            "unavailable"
          ]
        },
        "blockers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "volumeComparison": {
      "type": "object",
