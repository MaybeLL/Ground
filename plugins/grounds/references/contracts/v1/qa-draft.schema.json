    "retained_packages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "database_id": {
            "type": "string"
          },
          "operation_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          }
        },
        "required": [
          "digest",
          "database_id"
        ]
      },
      "maxItems": 100
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "related_drafts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 1000
        },
        "reason": {
          "enum": [
            "origin_repartitioned",
            "legacy_origin_unavailable"
          ]
        },
        "decision": {
          "enum": [
            "new",
            "existing"
          ]
        }
      },
      "required": [
        "related_drafts",
        "reason"
      ]
    },
    "bootstrap_origins": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "batch": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "span_digest": {
            "type": "string",
            "pattern": "^(?:sha256:)?[0-9a-f]{64}$"
          }
        },
        "required": [
          "key",
          "batch"
        ]
      }
    },
    "origin_closed": {
      "type": "boolean"
    }
  },
  "required": [
    "format",
    "id",
    "version",
    "identity",
    "state",
    "automatic",
    "suggestions",
    "manual",
    "review",
    "predecessors",
    "successors",
    "lineage"
  ]
}
