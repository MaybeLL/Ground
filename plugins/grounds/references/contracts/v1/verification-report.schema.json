{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patchledger.dev/contracts/v1/verification-report.schema.json",
  "title": "Grounds VerificationReport v1 验证报告",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "candidate_id", "result_tree_oid", "blind_context_digest", "assessments"],
  "properties": {
    "format": { "const": "patchledger.verification-report/v1" },
    "candidate_id": { "$ref": "common.schema.json#/$defs/id" },
    "result_tree_oid": { "$ref": "common.schema.json#/$defs/gitOid" },
    "blind_context_digest": { "$ref": "common.schema.json#/$defs/sha256" },
    "assessments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": { "$ref": "#/$defs/targetAssessment" }
    }
  },
  "$defs": {
    "targetAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_type", "target_id", "criteria"],
      "properties": {
        "target_type": { "enum": ["goal", "constraint"] },
        "target_id": { "$ref": "common.schema.json#/$defs/id" },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": { "$ref": "#/$defs/criterionAssessment" }
        }
      }
    },
    "criterionAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion_id", "independent", "reconciliation", "final"],
      "properties": {
        "criterion_id": { "$ref": "common.schema.json#/$defs/id" },
        "independent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["verdict", "explanation", "evidence"],
          "properties": {
            "verdict": { "$ref": "common.schema.json#/$defs/verdict" },
            "explanation": { "$ref": "common.schema.json#/$defs/longText" },
            "evidence": {
              "type": "array",
              "maxItems": 8,
              "items": { "$ref": "common.schema.json#/$defs/evidenceInput" }
            }
          }
        },
        "reconciliation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["claim_relation", "explanation"],
          "properties": {
            "claim_relation": {
              "enum": ["corroborated", "contradicted", "not_determined"]
            },
            "explanation": { "$ref": "common.schema.json#/$defs/longText" }
          }
        },
        "final": {
          "type": "object",
          "additionalProperties": false,
          "required": ["verdict", "explanation"],
          "properties": {
            "verdict": { "$ref": "common.schema.json#/$defs/verdict" },
            "explanation": { "$ref": "common.schema.json#/$defs/longText" }
          }
        }
      }
    }
  }
}
